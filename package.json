{
  "name": "piton",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "CLOUDFLARE_INCLUDE_PROCESS_ENV=true wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
