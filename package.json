    "history": "node scripts/history.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "grammy": "1.46.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "wrangler": "4.151.3"
  }
}
